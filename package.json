{
  "name": "prodlean",
  "private": true,
  "description": "ProdLean — Engenharia de Produção para estudantes, engenheiros e professores (PWA em JavaScript puro; o build gera catálogo, fórmulas em LaTeX e minifica).",
  "scripts": {
    "build": "node scripts/build.js",
    "catalogo": "node scripts/build.js --catalogo",
    "checar": "node scripts/build.js --checar && node testes/validar-grade.js",
    "testar-seo": "node scripts/build.js && node testes/teste-seo.js",
    "vendor": "node scripts/vendor.js",
    "formulas": "node scripts/formulas-tex.js",
    "questoes": "node scripts/questoes/mrp.js"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "esbuild": "^0.28.2",
    "katex": "^0.19.0",
    "lucide-static": "^1.51.0"
  },
  "engines": {
    "node": ">=18"
  }
}
